# Be Fortified Christians Environment Configuration

# 1. Supabase Cloud Database Configuration
# Obtain from https://supabase.com/dashboard/project/<your-project-ref>/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Telegram Admin Bot Token
# Obtain from @BotFather on Telegram (run /newbot)
TELEGRAM_BOT_TOKEN=

# 3. Optional: Allowed Telegram Admin User IDs (comma separated)
# If empty, all users can interact for testing
ADMIN_TELEGRAM_IDS=
